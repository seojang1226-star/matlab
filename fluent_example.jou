; ============================================
; ANSYS Fluent Journal File Example
; ============================================
; 이 파일은 Fluent에서 직접 실행할 수 있는 Journal 파일입니다.
;
; 실행 방법:
; 1. GUI에서: File > Read > Journal... 선택
; 2. 명령줄에서: fluent 3ddp -i fluent_example.jou
;
; 주의: 세미콜론(;)으로 시작하는 줄은 주석입니다.
; ============================================

; 1. 격자 파일 읽기
; ============================================
; 실제 격자 파일 경로로 변경하세요
/file/read-case /path/to/your/mesh_file.msh

; 2. 단위 체계 확인 및 설정
; ============================================
/define/units/length m
/define/units/pressure pa
/define/units/temperature k

; 3. 솔버 설정
; ============================================
; Pressure-based solver, steady state
/define/models/solver/pressure-based yes
/define/models/steady yes

; 4. 난류 모델 설정
; ============================================
; k-epsilon standard 모델
/define/models/viscous/ke-standard yes

; 5. 재료 물성 설정
; ============================================
; 공기 물성 (밀도: 1.225 kg/m³, 점성: 1.7894e-05 kg/m·s)
/define/materials/change-create air air yes constant 1.225 no no yes constant 1.7894e-05 no no no no no

; 6. 경계 조건 설정
; ============================================

; 입구: velocity-inlet (10 m/s)
; 형식: /define/boundary-conditions/velocity-inlet zone-name []
; [] 내부: 속도, 온도, 난류 옵션 등
/define/boundary-conditions/velocity-inlet inlet yes no 10 no 300 no no yes 5 10

; 출구: pressure-outlet (0 Pa gauge pressure)
/define/boundary-conditions/pressure-outlet outlet yes no 0 no 300 no yes no yes 5 10

; 벽면: wall (no-slip)
/define/boundary-conditions/wall wall yes no 0 no 0 no 0 no no no 0 no 0.5 no 1

; 7. 솔루션 제어 설정
; ============================================
; Under-relaxation factors
/solve/set/under-relaxation/pressure 0.3
/solve/set/under-relaxation/momentum 0.7
/solve/set/under-relaxation/k 0.8
/solve/set/under-relaxation/epsilon 0.8

; Discretization schemes
/solve/set/discretization-scheme/pressure 12
/solve/set/discretization-scheme/mom 1
/solve/set/discretization-scheme/k 1
/solve/set/discretization-scheme/epsilon 1

; 8. 수렴 조건 설정
; ============================================
; 잔차 수렴 기준: 1e-4
/solve/monitors/residual/convergence-criteria 1e-4 1e-4 1e-4 1e-4 1e-4 1e-4

; 9. 솔루션 초기화
; ============================================
; Hybrid initialization (권장)
/solve/initialize/hyb-initialization

; 또는 Standard initialization:
; /solve/initialize/compute-defaults/all-zones
; /solve/initialize/initialize-flow

; 10. 자동 저장 설정
; ============================================
/file/auto-save/data-frequency 50
/file/auto-save/case-frequency if-mesh-is-modified
/file/auto-save/root-name /home/user/matlab/autosave

; 11. 계산 실행
; ============================================
; 100회 반복 계산
/solve/iterate 100

; 12. 결과 저장
; ============================================
/file/write-case-data /home/user/matlab/fluent_journal_results.cas.h5

; 13. 리포트 생성
; ============================================
; 면적 적분
/report/surface-integrals/area inlet ()

; 질량 유량 리포트
/report/surface-integrals/mass-flow inlet ()
/report/surface-integrals/mass-flow outlet ()

; 14. 추가 계산 (필요시)
; ============================================
; 추가 50회 반복
; /solve/iterate 50

; 15. 최종 저장 및 종료
; ============================================
/file/write-case-data /home/user/matlab/fluent_final_results.cas.h5

; Fluent 종료 (배치 모드에서만)
/exit
yes
